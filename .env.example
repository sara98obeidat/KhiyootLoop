# KhiyootLoop environment variables
# ---------------------------------------------------------------------------
# Copy this file to .env.local for local development. NEVER commit real values.
# On Vercel, enter each value under Project → Settings → Environment Variables.
# None of these are sent to the browser (there are no NEXT_PUBLIC_ variables).

# --- Supabase (order database + founder login) ------------------------------
# Supabase dashboard → Project Settings → API (or "API Keys").
# e.g. https://abcdefgh.supabase.co
SUPABASE_URL=
# the "anon" / "publishable" key
SUPABASE_ANON_KEY=
# the "service_role" / "secret" key. SECRET: server only.
SUPABASE_SERVICE_ROLE_KEY=

# --- App secret ---------------------------------------------------------------
# A long random string (at least 32 characters) that signs customer order links
# and anonymises IP addresses for rate limiting. Generate one at
# https://generate-secret.vercel.app/48 or with: openssl rand -hex 32
APP_SECRET=

# --- Acknowledgment emails (OFF for the classroom test) ----------------------
# "manual" (default): no automatic emails. The founder acknowledges orders by
# hand from the dashboard. Resend is not needed.
# "automatic": send through Resend. Needs RESEND_API_KEY and EMAIL_FROM with a
# domain verified in Resend. Switch on later without changing any code.
EMAIL_ACKNOWLEDGMENTS=manual
# Resend dashboard → API Keys. SECRET. (Only for automatic mode.)
RESEND_API_KEY=
# e.g. KhiyootLoop <orders@your-domain.com> (Only for automatic mode.)
EMAIL_FROM=
# optional: where customer replies go
EMAIL_REPLY_TO=
# optional: Resend → Webhooks → signing secret (enables "delivered"/"bounced")
RESEND_WEBHOOK_SECRET=

# --- Site ---------------------------------------------------------------------
# Optional. Leave empty on Vercel: the site uses the address Vercel gives it
# (e.g. https://khiyootloop.vercel.app). Set it only if you add your own domain later.
SITE_URL=

# --- Order mode -----------------------------------------------------------------
# Leave this as false. Real (live) orders also need every item in
# src/config/site.ts confirmed. Until then the site stays in classroom test mode.
ENABLE_LIVE_ORDERS=false

# --- Development only (ignored in production builds) ---------------------------
# KL_DEV_MEMORY_BACKEND=1            # keep orders in temporary memory instead of Supabase
# KL_DEV_FAKE_EMAIL=accept           # simulate email: accept | fail
# KL_DEV_FOUNDER_EMAIL=founder@example.test
# KL_DEV_FOUNDER_PASSWORD=choose-a-local-password
